/* ==================================================================== LAYERED WAVE meter (VIZ_LAYERED_WAVE)
 * Nested, mirrored envelope layers on a solid background (docs/features/meters/LAYERED_WAVE_METER_SPEC.md). Inputs are hardware only: the 16 band
 * levels from the spectrum bank (in->spec) and, for the DYNAMICS split, the capture's waveform peak (in->wave). Draws with plain fb_rect().
 *
 * This is the C twin of tools/meters/preview/meters/layered_wave.js: the same integer operations in the same order, so both issue the same engine
 * commands for the same input (sim/test_layered_wave_golden.py compares them command for command; the JS module's header lists the rules that keep
 * them equal). Change one, change the other, run `make test-host`. No floating point anywhere (rv32im has no FPU); the only tables are generated by
 * tools/gen_layered_wave_tables.py into fw/layered_wave_tables.h (cold data).
 *
 * Cost: one command per run of equal-height cells per layer plus the background. A self-scaling `stride` (the width of one evaluation cell) widens
 * when the previous frame needed more than LW_BUDGET commands and narrows when it needed less than half, so a 6-layer 400-column setting degrades
 * to coarser steps instead of starving the audio loop (the B-299 lesson). The meter is COLD code; its 6 x 404-byte history is a RING in PSRAM
 * (MTR_PSRAM, B-509, see below), the rest -- 6 x 16 band words and a few dozen scalars, plus a 404-byte unwrap scratch -- is plain RAM. */
#include "layered_wave_tables.h"

#define LW_MAXL   6u
#define LW_NB     16u
#define LW_AGE    8u
#define LW_BUDGET 300u
#define LW_HMAX   404u                 /* res (<= 400) + 4 */

typedef struct { uint8_t view, layers, split, outer, nest, draw, speed, response, taper, color_mode, grad, color_outer, color_inner, color_bg, xo[5], hstyle, aa, bmode, balpha, guard; int8_t g[6]; uint16_t res, custom_outer, custom_inner, custom_bg; } lw_p_t;   /* hstyle..g[]: the experimental group (zero unless TAU_DIAGNOSTIC) */

/* HISTORY lives in PSRAM as a ring (B-509, the meter framework's rule for mutable state, fw/meter.h / METER_MODULE_SPEC.md D-M14): 6 x 404 bytes
 * (2,424 B) off the scarce on-chip RAM. The old design SHIFTED up to 400 bytes per layer per push, free in SRAM and ruinous through a ~32-cycle
 * window; a ring turns a push into one word read-modify-write per layer. `lw_head` is the ring index of the newest sample and is shared, because
 * every layer pushes together (a layer-count change resets, see lw_key). Sample j (0 = newest) is at ring index (lw_head + j) mod LW_HMAX. A frame
 * unwraps what it draws into the 404-byte hot scratch `lw_row` with WORD reads (lw_unwrap), after which the draw code is unchanged from the shift
 * register's. The storage is uint32_t words on purpose: word-aligned access only, no byte-lane assumption, and no aliasing on the host build. */
#define LW_RW (LW_HMAX / 4u)
_Static_assert(LW_HMAX % 4u == 0u, "the ring is addressed in whole words, and a word must never straddle the wrap");
_Static_assert(LW_HMAX >= 400u + 4u, "a frame reads res + 4 history samples, res <= 400: the ring must hold them all or old samples alias new ones");
static uint32_t lw_ring[LW_MAXL][LW_RW] MTR_PSRAM;
static uint8_t  lw_row[LW_HMAX];
static uint16_t lw_head;
static int16_t  lw_band[LW_MAXL][LW_NB];
static int32_t  lw_s[LW_MAXL], lw_e[LW_NB], lw_key[6], lw_geo[4], lw_soft[13], lw_acc, lw_cnt;   /* lw_key: sizes and geometry (a change resets), lw_soft: everything else (a change only repaints) */
static uint8_t  lw_ebounds[LW_MAXL + 1u], lw_ebounds_ok, lw_etick, lw_stride, lw_init, lw_dirty;

static const uint16_t lw_fw[6] = { 1000, 1600, 2560, 4096, 6554, 10486 };   /* BASS_FINE group weights, 1.6^i x 1000 */

static inline int32_t lw_clamp(int32_t v, int32_t a, int32_t b) { return v < a ? a : v > b ? b : v; }
static inline int32_t lw_min(int32_t a, int32_t b) { return a < b ? a : b; }
static inline int32_t lw_max(int32_t a, int32_t b) { return a > b ? a : b; }

COLD_FN3 static uint32_t lw_isqrt(uint64_t n)
{
    uint64_t r = 0, bit = 1ull << 62;
    while (bit > n) bit >>= 2;
    while (bit) { if (n >= r + bit) { n -= r + bit; r = (r >> 1) + bit; } else r >>= 1; bit >>= 2; }
    return (uint32_t)r;
}

COLD_FN3 static void lw_rect(uint32_t x, uint32_t y, uint32_t w, uint32_t h, uint16_t c) { fig_rect(x, y, w, h, c); lw_cnt++; }

#ifdef LW_STATS
/* Where the figure is drawn is not this file's business (B-521): helios_meter() (fw/player.c) points RECT-class commands at the right buffer and presents
 * the finished box, the same for every context (docs/issues/022, B-520). What is measured here is what only this file knows: commands issued, the CPU time to
 * issue them, and how much of that was reading the PSRAM history. Info > LW COST. */
static uint32_t lw_t_cpu, lw_t_unw, lw_cmd_last;
#endif

/* ---- colours ------------------------------------------------------------------------------------------------------------------- */
#include "meter_core.h"   /* include-guarded; this module uses mtr_mix256 */
COLD_FN3 static uint16_t lw_mix(uint16_t a, uint16_t b, int32_t t256) { return mtr_mix256(a, b, t256); }   /* the implementation lives in fw/meter_core.h */
COLD_FN3 static uint16_t lw_pack(int32_t r, int32_t g, int32_t b) { return (uint16_t)((((r * 31 + 127) / 255) << 11) | (((g * 63 + 127) / 255) << 5) | ((b * 31 + 127) / 255)); }
COLD_FN3 static uint16_t lw_hue_rot(uint16_t c, uint32_t which)               /* 0 = -30, 1 = +30, 2 = 180 degrees; grey stays grey */
{
    const int32_t r = (((c >> 11) & 31) * 255 + 15) / 31, g = (((c >> 5) & 63) * 255 + 31) / 63, b = ((c & 31) * 255 + 15) / 31;
    int32_t o[3];
    for (uint32_t i = 0; i < 3u; i++) o[i] = lw_clamp((lw_hue[which][i * 3] * r + lw_hue[which][i * 3 + 1] * g + lw_hue[which][i * 3 + 2] * b + 512) >> 10, 0, 255);
    return lw_pack(o[0], o[1], o[2]);
}
COLD_FN3 static uint16_t lw_role(uint32_t i)                              /* order = the manifest's colour-role enum */
{
    switch (i) {
    case 0:  return ui_accent;
    case 1:  return th_role[TR_TEXT_PRIMARY];
    case 2:  return th_role[TR_TEXT_SECONDARY];
    case 3:  return th_role[TR_OK];
    case 4:  return th_role[TR_WARN];
    case 5:  return th_role[TR_DANGER];
    case 6:  return th_role[TR_PILL];
    case 7:  return th_role[TR_ERROR];
    case 8:  return th_role[TR_SURFACE];
    case 9:  return th_role[TR_SURFACE_TRACK];
    case 10: return th_role[TR_BASE];
    default: return th_role[TR_BG_BOTTOM];
    }
}
COLD_FN3 static void lw_ends(const lw_p_t *p, uint16_t *e)                /* outer, inner, background */
{
    if (p->color_mode == 2u) { e[0] = p->custom_outer; e[1] = p->custom_inner; e[2] = p->custom_bg; return; }
    if (p->color_mode == 1u) { e[0] = lw_role(p->color_outer); e[1] = lw_role(p->color_inner); e[2] = lw_role(p->color_bg); return; }
    const uint16_t a = ui_accent, bg = lw_mix(th_role[TR_BASE], a, 36);
    switch (p->grad) {
    case 1:  e[0] = lw_mix(a, 0, 150); e[1] = a; break;                       /* SHADES */
    case 2:  e[0] = lw_hue_rot(a, 0); e[1] = lw_hue_rot(a, 1); break;                 /* ANALOGOUS */
    case 3:  e[0] = a; e[1] = lw_hue_rot(a, 2); break;                            /* COMPLEMENT */
    default: e[0] = a; e[1] = lw_mix(a, 0xFFFFu, 180); break;                 /* TINTS */
    }
    e[2] = bg;
}
typedef struct { uint16_t base[LW_MAXL], tbl[LW_MAXL][LW_AGE], bg, co, ci; } lw_col_t;
COLD_FN3 static void lw_colours(const lw_p_t *p, lw_col_t *c)
{
    uint16_t e[3];
    lw_ends(p, e);
    c->co = e[0]; c->ci = e[1]; c->bg = e[2];
    const int32_t n = p->layers;
    for (int32_t k = 0; k < n; k++) {
        c->base[k] = n == 1 ? e[0] : lw_mix(e[0], e[1], (k * 512 + (n - 1)) / (2 * (n - 1)));
        for (int32_t q = 0; q < (int32_t)LW_AGE; q++) c->tbl[k][q] = lw_mix(c->base[k], e[2], ((int32_t)p->taper * (2 * q + 1) * 128 + 500) / 1000);
    }
}

/* ---- band split ---------------------------------------------------------------------------------------------------------------- */
COLD_FN3 static void lw_fix(uint8_t *b, int32_t n)
{
    b[0] = 0; b[n] = (uint8_t)LW_NB;
    for (int32_t i = n - 1; i >= 1; i--) b[i] = (uint8_t)lw_min(b[i], (int32_t)LW_NB - (n - i));
    for (int32_t i = 1; i < n; i++) b[i] = (uint8_t)lw_max(b[i], b[i - 1] + 1);
}
COLD_FN3 static void lw_bounds(uint32_t split, int32_t n, uint8_t *b, const uint8_t *xo)
{
    if (split == 4u) {                       /* CUSTOM: the boundaries are parameters (band index between layer i and i+1) */
        b[0] = 0;
        for (int32_t i = 1; i < n; i++) b[i] = xo[i - 1];
    } else if (split == 1u) {
        int32_t s = 0, acc = 0;
        for (int32_t i = 0; i < n; i++) s += lw_fw[i];
        b[0] = 0;
        for (int32_t i = 1; i <= n; i++) { acc += lw_fw[i - 1]; b[i] = (uint8_t)((acc * 32 + s) / (2 * s)); }
    } else if (split == 2u && lw_ebounds_ok) {
        for (int32_t i = 0; i <= n; i++) b[i] = lw_ebounds[i];
        return;
    } else {
        b[0] = 0;
        for (int32_t i = 1; i <= n; i++) b[i] = (uint8_t)((i * 32 + n) / (2 * n));
    }
    lw_fix(b, n);
}
COLD_FN3 static void lw_learn(const uint8_t *spec, int32_t n)             /* ENERGY: boundaries at equal cumulative slow-averaged energy, ~4 times a second */
{
    mtr_ema_pow(lw_e, spec, LW_NB, 48);
    if (++lw_etick < 12u) return;
    lw_etick = 0;
    int32_t tot = 0, acc = 0, g = 1, cnt = 1;
    uint8_t b[LW_MAXL + 1u];
    for (uint32_t k = 0; k < LW_NB; k++) tot += lw_e[k] + 130;
    b[0] = 0;
    for (uint32_t k = 0; k < LW_NB && g < n; k++) { acc += lw_e[k] + 130; while (g < n && acc * n >= tot * g) { b[cnt++] = (uint8_t)(k + 1u); g++; } }
    while (cnt < n) b[cnt++] = (uint8_t)LW_NB;
    b[cnt] = (uint8_t)LW_NB;
    lw_fix(b, n);
    for (int32_t i = 0; i <= n; i++) lw_ebounds[i] = b[i];
    lw_ebounds_ok = 1u;
}
COLD_FN3 static int32_t lw_pnorm(const uint8_t *spec, int32_t lo, int32_t hi, int32_t denom)   /* Q12 power mean of the bands lo..hi-1 */
{
    uint32_t sum = 0;
    for (int32_t k = lo; k < hi; k++) { const uint32_t a = (uint32_t)spec[k] * spec[k]; sum += (a * a) >> 16; }
    const uint32_t M = ((sum * 1040u) >> 10) / (uint32_t)denom, s1 = lw_isqrt((uint64_t)M * 65536u), s2 = lw_isqrt((uint64_t)s1 * 65536u);
    return (int32_t)(lw_min((int32_t)lw_min((int32_t)s2, 65536), 65536) >> 4);
}
COLD_FN3 static void lw_targets(const lw_p_t *p, const uint8_t *spec, const int8_t *wave, int32_t *out)
{
    const int32_t n = p->layers;
    if (p->split == 3u) {
        int32_t pk = 0;
        for (uint32_t i = 0; i < WAVE_COLS; i++) { const int32_t a = wave[i] < 0 ? -wave[i] : wave[i]; if (a > pk) pk = a; }
        const int32_t x = lw_min(4096, pk * 47);
        for (int32_t k = 0; k < n; k++) out[k] = n == 1 ? x : (x * (1024 - (512 * k) / (n - 1))) >> 10;
        return;
    }
    if (p->split == 2u) lw_learn(spec, n);
    uint8_t b[LW_MAXL + 1u];
    lw_bounds(p->split, n, b, p->xo);
    for (int32_t k = 0; k < n; k++) {
        if (p->nest == 0u) {
            const int32_t lo = p->outer == 0u ? b[k] : 0, hi = p->outer == 0u ? (int32_t)LW_NB : b[n - k], v = lw_pnorm(spec, lo, hi, 4);
            out[k] = n == 1 ? v : (v * (1024 - (410 * k) / (n - 1))) >> 10;
        } else {
            const int32_t g = p->outer == 0u ? k : n - 1 - k;
            out[k] = lw_pnorm(spec, b[g], b[g + 1], b[g + 1] - b[g]);
        }
    }
}

/* ---- ballistics ---------------------------------------------------------------------------------------------------------------- */
COLD_FN3 static uint32_t lw_coef(int32_t response, int32_t mul, int32_t dt, int32_t att)   /* Q16 of 1 - exp(-dt/tau) */
{
    uint32_t tau = (4200u * 256u) / (uint32_t)(6 + response);
    if (att) tau >>= 2;
    tau = (tau * (uint32_t)mul) >> 8;
    const uint64_t y = ((uint32_t)dt * 16777216u) / tau >> 3, y2 = (y * y) >> 16, y3 = (y2 * y) >> 16, y4 = (y3 * y) >> 16;
    const uint32_t D = 65536u + (uint32_t)y + (uint32_t)(y2 >> 1) + (uint32_t)(y3 / 6u) + (uint32_t)(y4 / 24u);
    uint32_t E = 2147483648u / (D >> 1);
    if (E > 65535u) E = 65535u;
    for (uint32_t i = 0; i < 3u; i++) E = (E * E) >> 16;
    return 65536u - E;
}
static inline int32_t lw_step(int32_t s, int32_t t, uint32_t ca, uint32_t cr) { return s + (((t - s) * (int32_t)(t > s ? ca : cr)) >> 16); }
static inline uint32_t lw_u8(int32_t v) { return (uint32_t)lw_min(255, (v * 255 + 2048) >> 12); }

/* ---- shape --------------------------------------------------------------------------------------------------------------------- */
COLD_FN3 static int32_t lw_win(const uint8_t (*tab)[65], int32_t q, int32_t pos)
{
    const int32_t i0 = pos >> 8, fr = pos & 255, i1 = lw_min(64, i0 + 1);
    return (int32_t)tab[q - 1][i0] + ((((int32_t)tab[q - 1][i1] - (int32_t)tab[q - 1][i0]) * fr) >> 8);
}
COLD_FN3 static int32_t lw_cr8(const uint8_t *h, int32_t n, int32_t i, int32_t f)       /* Catmull-Rom on 0..255 samples, f in Q8 */
{
    const int32_t p0 = h[lw_max(i - 1, 0)], p1 = h[lw_min(i, n - 1)], p2 = h[lw_min(i + 1, n - 1)], p3 = h[lw_min(i + 2, n - 1)];
    const int32_t a = p2 - p0, b = 2 * p0 - 5 * p1 + 4 * p2 - p3, c = -p0 + 3 * p1 - 3 * p2 + p3;
    const int32_t t2 = b + ((c * f) >> 8), t1 = a + ((t2 * f) >> 8);
    return lw_clamp(p1 + ((t1 * f) >> 9), 0, 255);
}
COLD_FN3 static int32_t lw_half(int32_t a8, int32_t w8, int32_t Hh)                     /* half height in pixels; a thin centre line stays in silence */
{
    int32_t h = (a8 * w8 * Hh + 32512) / 65025;
    if (h < 1 && w8 > 64) h = 1;
    return h;
}

#if TAU_DIAGNOSTIC
COLD_FN3 static void lw_half_aa(int32_t a8, int32_t w8, int32_t Hh, int32_t L, int32_t *h, int32_t *q)   /* half height with sub-pixel coverage, L levels */
{
    const int32_t v = a8 * w8 * Hh;
    int32_t hh = v / 65025, qq = ((v - hh * 65025) * L + 32512) / 65025;
    if (qq >= L) { hh++; qq = 0; }
    if (hh < 1 && w8 > 64) { hh = 1; qq = 0; }
    *h = hh; *q = qq;
}
COLD_FN3 static void lw_seg(const int32_t *cen, int32_t n, int32_t pos, int32_t *g0, int32_t *g1, int32_t *f)   /* which two layer centres pos lies between, and how far (Q8) */
{
    if (pos <= cen[0]) { *g0 = 0; *g1 = 0; *f = 0; return; }
    if (pos >= cen[n - 1]) { *g0 = n - 1; *g1 = n - 1; *f = 0; return; }
    int32_t g = 0;
    while (pos > cen[g + 1]) g++;
    *g0 = g; *g1 = g + 1; *f = ((pos - cen[g]) * 256) / (cen[g + 1] - cen[g]);
}
#else
#define lw_half_aa(a8, w8, Hh, L, h, q) do { *(h) = 0; *(q) = 0; } while (0)
#endif

COLD_FN3 static void lw_reinit(const lw_p_t *p, uint32_t W, const int32_t *key, const int32_t *soft)
{
    for (uint32_t i = 0; i < 6u; i++) lw_key[i] = key[i];
    for (uint32_t i = 0; i < 13u; i++) lw_soft[i] = soft[i];
    lw_init = 1u; lw_acc = 0; lw_dirty = 1u; lw_etick = 0; lw_ebounds_ok = 0u; lw_cnt = 0;
    lw_head = 0;
    for (uint32_t k = 0; k < LW_MAXL; k++) {
        lw_s[k] = 0;
        for (uint32_t i = 0; i < LW_RW; i++) lw_ring[k][i] = 0;      /* ~600 window stores, ~16k cycles, only on a reset */
        for (uint32_t i = 0; i < LW_NB; i++) lw_band[k][i] = 0;
    }
    for (uint32_t i = 0; i < LW_NB; i++) lw_e[i] = 0;
    lw_stride = (uint8_t)(1 + ((int32_t)p->layers * (int32_t)W) / 900);
}

/* ---- experimental settings (the Diagnostic Build only; in the main build every one of these is a no-op and the settings do not exist) ----------------- */
#if TAU_DIAGNOSTIC
static const uint8_t lw_aa_levels[4] = { 0, 2, 4, 8 };
static const int32_t lw_budgets[3] = { LW_BUDGET, 600, 1000000000 };               /* cost guard ON / RELAXED / OFF */
static inline int32_t lw_gm(const lw_p_t *p, int32_t k) { return lw_gain_q8[lw_clamp(p->g[k], -18, 18) + 18]; }
COLD_FN3 static int32_t lw_bch(int32_t b, int32_t f, int32_t mode, int32_t alpha, int32_t mx)   /* the blend unit's per-channel arithmetic (mp3_fb.sv blend_ch) */
{
    switch (mode) {
    case 0:  return (f * alpha + b * (256 - alpha)) >> 8;
    case 1:  return (b + f) >> 1;
    case 2:  return lw_min(mx, b + f);
    case 3:  return f > b ? 0 : b - f;
    default: return lw_min(mx, b + (f >> 2));
    }
}
COLD_FN3 static uint16_t lw_blend_px(uint16_t bg, uint16_t fg, int32_t mode, int32_t alpha)
{
    return (uint16_t)((lw_bch(bg >> 11, fg >> 11, mode, alpha, 31) << 11) | (lw_bch((bg >> 5) & 63, (fg >> 5) & 63, mode, alpha, 63) << 5) | lw_bch(bg & 31, fg & 31, mode, alpha, 31));
}
#endif

/* per frame: antialiasing level, blend mode/alpha, box, and (Diagnostic Build) the per-column memory of the layer drawn before (ph/pc) and of the layer being
 * drawn (nh/nc) that blending and the antialiasing edge colour need. It is scratch for one lw_tick, so it lives on the stack, not in static RAM. */
typedef struct { int32_t L, bm, ba, arr, X, Y, H, W, cy; uint16_t bgc;
#if TAU_DIAGNOSTIC
    uint8_t *ph, *nh; uint16_t *pc, *nc;
#endif
} lw_lay_t;
typedef struct { int32_t x0, x1, h, cv; uint16_t c; } lw_run_t;

COLD_FN3 static void lw_cell(const lw_lay_t *l, int32_t k, int32_t xs, int32_t wd, int32_t xc, int32_t *hh, int32_t *cv, uint16_t *c)
{
#if TAU_DIAGNOSTIC
    if (l->bm) {                                    /* blending: each layer is clamped to the one outside it, so the colour underneath is known */
        if (k > 0) { const int32_t ph = l->ph[xc]; if (*hh > ph) { *hh = ph; *cv = 0; } }
        *c = lw_blend_px(k > 0 ? l->pc[xc] : l->bgc, *c, l->bm - 1, l->ba);
    }
    if (l->arr) for (int32_t x = xs; x < xs + wd; x++) { l->nh[x] = (uint8_t)*hh; l->nc[x] = *c; }
#else
    (void)l; (void)k; (void)xs; (void)wd; (void)xc; (void)hh; (void)cv; (void)c;
#endif
}
COLD_FN3 static void lw_emit(const lw_lay_t *l, int32_t k, const lw_run_t *r)
{
#if TAU_DIAGNOSTIC
    if (l->L && r->cv) {                            /* antialiasing: the row just outside each edge, the layer colour mixed over what is there by the coverage */
        const int32_t d = r->h + 1, yt = l->cy - r->h - 1, yb = l->cy + r->h;
        int32_t a = r->x0, cur = (k > 0 && l->ph[r->x0] >= d) ? (int32_t)l->pc[r->x0] : (int32_t)l->bgc;
        for (int32_t x = r->x0 + 1; x <= r->x1; x++) {
            const int32_t u = x < r->x1 ? ((k > 0 && l->ph[x] >= d) ? (int32_t)l->pc[x] : (int32_t)l->bgc) : -1;
            if (u != cur) {
                const uint16_t ec = lw_mix((uint16_t)cur, r->c, (r->cv * 256) / l->L);
                if (yt >= l->Y) lw_rect(l->X + a, yt, x - a, 1, ec);
                if (yb < l->Y + l->H) lw_rect(l->X + a, yb, x - a, 1, ec);
                a = x; cur = u;
            }
        }
    }
#else
    (void)k;
#endif
    lw_rect(l->X + r->x0, l->cy - r->h, r->x1 - r->x0, 2 * r->h, r->c);
}
COLD_FN3 static void lw_endlayer(const lw_lay_t *l)
{
#if TAU_DIAGNOSTIC
    if (l->arr) for (int32_t x = 0; x < l->W; x++) { l->ph[x] = l->nh[x]; l->pc[x] = l->nc[x]; }
#else
    (void)l;
#endif
}
/* run building shared by the three layer functions: extend the current run or flush it and start a new one */
#define LW_RUN_STEP(K, HH, CC, CV) do { \
    if (have && run.h == (HH) && run.c == (CC) && run.cv == (CV)) { run.x1 = xs + wd; continue; } \
    if (have) lw_emit(lay, (K), &run); \
    have = (HH) > 0; run.x0 = xs; run.x1 = xs + wd; run.h = (HH); run.c = (CC); run.cv = (CV); } while (0)

/* Push the current layer values lw_s[0..n-1] as the new newest sample of each layer. The head moves back one slot (every layer pushes at the same
 * index), then each layer takes ONE word read-modify-write; (uint8_t) is the truncation the shift-register's own store had. */
COLD_FN3 static void lw_push(int32_t n)
{
    lw_head = (uint16_t)(lw_head == 0u ? LW_HMAX - 1u : lw_head - 1u);
    const uint32_t wi = (uint32_t)lw_head >> 2, sh = ((uint32_t)lw_head & 3u) * 8u;
    for (int32_t k = 0; k < n; k++) lw_ring[k][wi] = (lw_ring[k][wi] & ~(0xFFu << sh)) | ((uint32_t)(uint8_t)lw_u8(lw_s[k]) << sh);
}

/* Unwrap layer k's newest `len` samples (newest first) into the hot scratch lw_row: lw_row[j] = the value pushed j pushes ago, exactly what
 * `h[j]` was in the shift-register design, so everything downstream (lw_cr8, the nearest-sample read) is untouched. One window READ per four
 * samples (~32 cycles each, so ~3k cycles for a full 404-sample layer) instead of one per sample. Pure shifts and masks on a u32, so the result is
 * the same on little- and big-endian hosts. The ring length is a multiple of 4, so a word never straddles the wrap. */
COLD_FN3 static void lw_unwrap(int32_t k, uint32_t len)
{
#ifdef LW_STATS
    const uint32_t u0 = cycles();
#endif
    uint32_t i = lw_head, j = 0;
    while (j < len) {
        const uint32_t w = lw_ring[k][i >> 2];
        for (uint32_t b = i & 3u; b < 4u && j < len; b++) lw_row[j++] = (uint8_t)(w >> (b * 8u));
        i = (i & ~3u) + 4u;
        if (i >= LW_HMAX) i -= LW_HMAX;
    }
#ifdef LW_STATS
    lw_t_unw += (uint32_t)(cycles() - u0);
#endif
}

COLD_FN3 static void lw_history(const lw_p_t *p, const mtr_in_t *in, const lw_col_t *cl, int32_t cy, int32_t Hh, const lw_lay_t *lay)
{
    const int32_t W = in->w, X = in->x, n = p->layers, res = p->res, smooth = p->draw == 1u, dt = in->dt_ms;
    int32_t tg[LW_MAXL];
    lw_targets(p, in->spec, in->wave, tg);
    for (int32_t k = 0; k < n; k++) {
        const int32_t m = (p->split == 3u && n > 1) ? (int32_t)lw_mul_q8[n - 1 - 2 * k + 5] : 256;
        int32_t tk = tg[k];
#if TAU_DIAGNOSTIC
        { const int32_t gk = lw_gm(p, k); if (gk != 256) tk = lw_min(4096, (tk * gk) >> 8); }
#endif
        lw_s[k] = lw_step(lw_s[k], tk, lw_coef(p->response, m, dt, 1), lw_coef(p->response, m, dt, 0));
    }
    lw_acc += (dt * p->speed * res * 256) / (1000 * W);
    const int32_t pushes = lw_min(lw_acc >> 8, res);
    lw_acc &= 255;
    for (int32_t i = 0; i < pushes; i++) lw_push(n);
    if (!smooth && pushes == 0 && !lw_dirty) return;
    lw_dirty = 0u;
    const int32_t phase = lw_acc, tq = ((int32_t)p->taper + 2) / 5, s = lw_stride, aaL = lay->L;
    lw_rect(X, in->y, W, in->h, cl->bg);
    for (int32_t k = 0; k < n; k++) {
        lw_unwrap(k, (uint32_t)(res + 4));                 /* res + 4 = every sample lw_cr8() and the nearest read can touch */
        const uint8_t *h = lw_row;
        lw_run_t run = { 0, 0, 0, 0, 0 };
        int32_t have = 0;
        for (int32_t xs = 0; xs < W; xs += s) {
            const int32_t wd = lw_min(s, W - xs), xc = lw_min(W - 1, xs + (s >> 1));
            int32_t a8;
            if (smooth) { const int32_t t = ((2 * xc + 1) * res * 128) / W - phase - 128; a8 = t <= 0 ? h[0] : lw_cr8(h, res + 4, t >> 8, t & 255); }
            else a8 = h[lw_min(res - 1, (xc * res) / W)];
            const int32_t w8 = tq == 0 ? 255 : lw_win(lw_win_hist, tq, ((2 * xc + 1) * 8192) / W), q = lw_min((int32_t)LW_AGE - 1, ((2 * xc + 1) * 4) / W);
            int32_t hh, cv = 0;
            if (aaL) lw_half_aa(a8, w8, Hh, aaL, &hh, &cv); else hh = lw_half(a8, w8, Hh);
            uint16_t c = cl->tbl[k][q];
            lw_cell(lay, k, xs, wd, xc, &hh, &cv, &c);
            LW_RUN_STEP(k, hh, c, cv);
        }
        if (have) lw_emit(lay, k, &run);
        lw_endlayer(lay);
    }
    if (p->taper > 0u) {
        static const uint8_t dots[3] = { 4, 3, 3 };
        for (int32_t j = 0; j < 3; j++) { const int32_t d = dots[j]; lw_rect(X + W - 8 - j * 12 - (d >> 1), cy - (d >> 1), d, d, cl->tbl[n - 1][LW_AGE - 1u]); }
    }
}

#if TAU_DIAGNOSTIC
/* CURVE style: one continuous outline across the whole axis, coloured by a gradient whose stops are the layer colours at the centres of their frequency
 * ranges, with a smooth gain curve through the per-layer gains (all Q8 integer, the same operations as the JS twin's curveOutline). */
COLD_FN3 static void lw_curve(const lw_p_t *p, const mtr_in_t *in, const lw_col_t *cl, int32_t cy, int32_t Hh, const lw_lay_t *lay, const uint8_t *bnd, int32_t s)
{
    const int32_t W = in->w, n = p->layers, smooth = p->draw == 1u, tq = ((int32_t)p->taper + 2) / 5, aaL = lay->L, dt = in->dt_ms;
    const int32_t m = n > 1 ? (int32_t)lw_mul_q8[n - 1 + 5] : 256;
    const uint32_t ca = lw_coef(p->response, m, dt, 1), cr = lw_coef(p->response, m, dt, 0);
    int32_t cen[LW_MAXL], gdb[LW_MAXL];
    uint16_t col[LW_MAXL];
    uint8_t bu[LW_NB];
    for (int32_t g = 0; g < n; g++) {
        const int32_t lg = p->outer == 0u ? g : n - 1 - g;
        cen[g] = ((int32_t)bnd[g] + bnd[g + 1]) * 128; gdb[g] = lw_clamp(p->g[lg], -18, 18); col[g] = cl->base[lg];
    }
    for (uint32_t i = 0; i < LW_NB; i++) {
        const int32_t v = ((int32_t)in->spec[i] * 4096) / 255;
        lw_band[0][i] = (int16_t)lw_step(lw_band[0][i], v, ca, cr);
        int32_t g0, g1, f;
        lw_seg(cen, n, (int32_t)i * 256 + 128, &g0, &g1, &f);
        const int32_t dbq = gdb[g0] * 256 + (gdb[g1] - gdb[g0]) * f, vq = dbq + 18 * 256, i0 = vq >> 8, fr = vq & 255;
        const int32_t mult = (int32_t)lw_gain_q8[i0] + ((((int32_t)lw_gain_q8[lw_min(37, i0 + 1)] - (int32_t)lw_gain_q8[i0]) * fr) >> 8);
        bu[i] = (uint8_t)lw_min(255, (int32_t)(lw_u8(lw_band[0][i]) * (uint32_t)mult) >> 8);
    }
    lw_run_t run = { 0, 0, 0, 0, 0 };
    int32_t have = 0;
    for (int32_t xs = 0; xs < W; xs += s) {
        const int32_t wd = lw_min(s, W - xs), xc = lw_min(W - 1, xs + (s >> 1));
        int32_t a8;
        if (smooth) { const int32_t t = ((2 * xc + 1) * (int32_t)LW_NB * 128) / W - 128; a8 = t <= 0 ? bu[0] : lw_cr8(bu, (int32_t)LW_NB, t >> 8, t & 255); }
        else a8 = bu[lw_min((int32_t)LW_NB - 1, (xc * (int32_t)LW_NB) / W)];
        const int32_t w8 = tq == 0 ? 255 : lw_win(lw_win_spec, tq, ((2 * xc + 1) * 8192) / W);
        int32_t hh, cv = 0, g0, g1, f;
        if (aaL) lw_half_aa(a8, w8, Hh, aaL, &hh, &cv); else hh = lw_half(a8, w8, Hh);
        lw_seg(cen, n, ((2 * xc + 1) * (int32_t)LW_NB * 128) / W, &g0, &g1, &f);
        uint16_t c = lw_mix(col[g0], col[g1], f);
        lw_cell(lay, 0, xs, wd, xc, &hh, &cv, &c);
        LW_RUN_STEP(0, hh, c, cv);
    }
    if (have) lw_emit(lay, 0, &run);
    lw_endlayer(lay);
}
#endif

COLD_FN3 static void lw_spectrum(const lw_p_t *p, const mtr_in_t *in, const lw_col_t *cl, int32_t cy, int32_t Hh, const lw_lay_t *lay)
{
    const int32_t W = in->w, X = in->x, n = p->layers, smooth = p->draw == 1u, tq = ((int32_t)p->taper + 2) / 5, dt = in->dt_ms, aaL = lay->L;
    const int32_t s = lw_max(lw_stride, (W + (int32_t)p->res - 1) / (int32_t)p->res);   /* Resolution = columns across the width (cell width), never finer than the self-scaling stride allows */
    lw_rect(X, in->y, W, in->h, cl->bg);
    uint8_t bnd[LW_MAXL + 1u];
    if (p->split == 2u) lw_learn(in->spec, n);
    if (p->split != 3u) lw_bounds(p->split, n, bnd, p->xo);   /* frequency splits: each layer draws only the part of the axis it listens to */
#if TAU_DIAGNOSTIC
    if (p->hstyle == 2u && p->split != 3u) { lw_curve(p, in, cl, cy, Hh, lay, bnd, s); return; }
#endif
    for (int32_t k = 0; k < n; k++) {
        int32_t lo = 0, hi = (int32_t)LW_NB;
        if (p->split != 3u) {
            if (p->nest == 0u) { lo = p->outer == 0u ? bnd[k] : 0; hi = p->outer == 0u ? (int32_t)LW_NB : bnd[n - k]; }
            else { const int32_t g = p->outer == 0u ? k : n - 1 - k; lo = bnd[g]; hi = bnd[g + 1]; }
        }
        const int32_t m = n > 1 ? (int32_t)lw_mul_q8[n - 1 - 2 * k + 5] : 256, sc = n == 1 ? 1024 : 1024 - (512 * k) / (n - 1);
        const uint32_t ca = lw_coef(p->response, m, dt, 1), cr = lw_coef(p->response, m, dt, 0);
        uint8_t bu[LW_NB];
        for (uint32_t i = 0; i < LW_NB; i++) {
            const int32_t v = ((int32_t)in->spec[i] * 4096) / 255;
            lw_band[k][i] = (int16_t)lw_step(lw_band[k][i], v, ca, cr);
            int32_t wt = ((int32_t)i >= lo && (int32_t)i < hi) ? 256 : 0;
#if TAU_DIAGNOSTIC
            if (p->hstyle == 1u && p->split != 3u) wt = ((int32_t)i >= lo && (int32_t)i < hi) ? 256 : ((int32_t)i == lo - 1 || (int32_t)i == hi) ? 128 : ((int32_t)i == lo - 2 || (int32_t)i == hi + 1) ? 40 : 0;
#endif
            int32_t a = wt == 256 ? (int32_t)((lw_u8(lw_band[k][i]) * (uint32_t)sc) >> 10) : wt == 0 ? 0 : ((((int32_t)((lw_u8(lw_band[k][i]) * (uint32_t)sc) >> 10)) * wt) >> 8);
#if TAU_DIAGNOSTIC
            { const int32_t gk = lw_gm(p, k); if (gk != 256) a = lw_min(255, (a * gk) >> 8); }
#endif
            bu[i] = (uint8_t)a;
        }
        lw_run_t run = { 0, 0, 0, 0, 0 };
        int32_t have = 0;
        for (int32_t xs = 0; xs < W; xs += s) {
            const int32_t wd = lw_min(s, W - xs), xc = lw_min(W - 1, xs + (s >> 1));
            int32_t a8;
            if (smooth) { const int32_t t = ((2 * xc + 1) * (int32_t)LW_NB * 128) / W - 128; a8 = t <= 0 ? bu[0] : lw_cr8(bu, (int32_t)LW_NB, t >> 8, t & 255); }
            else a8 = bu[lw_min((int32_t)LW_NB - 1, (xc * (int32_t)LW_NB) / W)];
            const int32_t w8 = tq == 0 ? 255 : lw_win(lw_win_spec, tq, ((2 * xc + 1) * 8192) / W);
            int32_t hh, cv = 0;
            if (aaL) lw_half_aa(a8, w8, Hh, aaL, &hh, &cv); else hh = lw_half(a8, w8, Hh);
            uint16_t c = cl->base[k];
            lw_cell(lay, k, xs, wd, xc, &hh, &cv, &c);
            LW_RUN_STEP(k, hh, c, cv);
        }
        if (have) lw_emit(lay, k, &run);
        lw_endlayer(lay);
    }
}

COLD_FN3 static int lw_tick(const mtr_in_t *in)
{
    lw_p_t p;
    p.view = (uint8_t)MV_LAYERED_WAVE(VIEW);
    p.layers = (uint8_t)lw_clamp((int32_t)MV_LAYERED_WAVE(LAYERS), 1, (int32_t)LW_MAXL);
    p.split = (uint8_t)MV_LAYERED_WAVE(SPLIT); p.outer = (uint8_t)MV_LAYERED_WAVE(OUTER); p.nest = (uint8_t)MV_LAYERED_WAVE(NEST);
    p.draw = (uint8_t)MV_LAYERED_WAVE(DRAW);
    p.res = (uint16_t)lw_clamp((int32_t)MV_LAYERED_WAVE(RES), 16, 400);
    p.speed = (uint8_t)lw_clamp((int32_t)MV_LAYERED_WAVE(SPEED), 20, 240);
    p.response = (uint8_t)lw_clamp((int32_t)MV_LAYERED_WAVE(RESPONSE), 1, 100);
    p.taper = (uint8_t)lw_min(100, (int32_t)MV_LAYERED_WAVE(TAPER));
    p.xo[0] = (uint8_t)lw_clamp((int32_t)MV_LAYERED_WAVE(XO1), 1, 15); p.xo[1] = (uint8_t)lw_clamp((int32_t)MV_LAYERED_WAVE(XO2), 1, 15); p.xo[2] = (uint8_t)lw_clamp((int32_t)MV_LAYERED_WAVE(XO3), 1, 15);
    p.xo[3] = (uint8_t)lw_clamp((int32_t)MV_LAYERED_WAVE(XO4), 1, 15); p.xo[4] = (uint8_t)lw_clamp((int32_t)MV_LAYERED_WAVE(XO5), 1, 15);
    p.color_mode = (uint8_t)MV_LAYERED_WAVE(COLOR_MODE); p.grad = (uint8_t)MV_LAYERED_WAVE(GRAD);
    p.color_outer = (uint8_t)MV_LAYERED_WAVE(COLOR_OUTER); p.color_inner = (uint8_t)MV_LAYERED_WAVE(COLOR_INNER); p.color_bg = (uint8_t)MV_LAYERED_WAVE(COLOR_BG);
    p.custom_outer = (uint16_t)MV_LAYERED_WAVE(CUSTOM_OUTER); p.custom_inner = (uint16_t)MV_LAYERED_WAVE(CUSTOM_INNER); p.custom_bg = (uint16_t)MV_LAYERED_WAVE(CUSTOM_BG);
    p.hstyle = 0; p.aa = 0; p.bmode = 0; p.balpha = 60; p.guard = 0;
    for (uint32_t i = 0; i < 6u; i++) p.g[i] = 0;
#if TAU_DIAGNOSTIC
    p.hstyle = (uint8_t)lw_min(2, (int32_t)MV_LAYERED_WAVE(HSTYLE)); p.aa = (uint8_t)lw_min(3, (int32_t)MV_LAYERED_WAVE(AA)); p.bmode = (uint8_t)lw_min(5, (int32_t)MV_LAYERED_WAVE(BMODE));
    p.balpha = (uint8_t)lw_clamp((int32_t)MV_LAYERED_WAVE(BALPHA), 5, 100); p.guard = (uint8_t)lw_min(2, (int32_t)MV_LAYERED_WAVE(GUARD));
    p.g[0] = (int8_t)((int32_t)MV_LAYERED_WAVE(G1) - 18); p.g[1] = (int8_t)((int32_t)MV_LAYERED_WAVE(G2) - 18); p.g[2] = (int8_t)((int32_t)MV_LAYERED_WAVE(G3) - 18);
    p.g[3] = (int8_t)((int32_t)MV_LAYERED_WAVE(G4) - 18); p.g[4] = (int8_t)((int32_t)MV_LAYERED_WAVE(G5) - 18); p.g[5] = (int8_t)((int32_t)MV_LAYERED_WAVE(G6) - 18);
#endif

    lw_col_t cl;
    lw_colours(&p, &cl);
    /* The history ring is in PSRAM: nothing may be stored there until the window is proven (fw/meter.h). A bitstream without it leaves the box a flat
     * background, never a write to an address that is not RAM. Constant 1 on the host build. */
    if (!mtr_psram_ready()) { if (in->force) fb_rect(in->x, in->y, in->w, in->h, cl.bg); wviz_force = 0u; return in->force ? 1 : 0; }   /* 1: it drew (the box was filled) */
    /* Only the history/band array sizes force a reset (B-523). Everything else just repaints on the next frame and KEEPS the history, so changing a setting,
     * forcing a repaint (a view switch, entering fullscreen) or moving the box never makes the meter restart: that is what the owner saw as "the meter
     * restarts once or twice, particularly when I go fullscreen". The reset used to include the box geometry and any forced repaint, and then filled the box
     * directly on screen with one unclipped rectangle, which also erased the fullscreen label corner whenever a preset change caused a reset. The frame's own
     * draw wipes the whole box (inside helios_meter's compose), so no separate wipe is needed here. */
    const int32_t key[6] = { p.layers, p.res, 0, 0, 0, 0 };
    const int32_t geo[4] = { in->w, in->h, in->x, in->y };
    const int32_t soft[13] = { p.view, p.draw, p.split, p.outer, p.nest, p.taper, cl.co, cl.ci, cl.bg, p.aa, p.bmode, p.balpha, p.hstyle };
    int32_t same = lw_init;
    for (uint32_t i = 0; i < 2u && same; i++) if (lw_key[i] != key[i]) same = 0;
    if (!same) { lw_reinit(&p, in->w, key, soft); for (uint32_t i = 0; i < 4u; i++) lw_geo[i] = geo[i]; }
    else {
        for (uint32_t i = 0; i < 13u; i++) if (lw_soft[i] != soft[i]) { lw_soft[i] = soft[i]; lw_dirty = 1u; }
        if (in->force) lw_dirty = 1u;
        for (uint32_t i = 0; i < 4u; i++) if (lw_geo[i] != geo[i]) {                       /* the box moved or resized: repaint, and size the stride for the new width */
            for (uint32_t k = 0; k < 4u; k++) lw_geo[k] = geo[k];
            lw_dirty = 1u; lw_stride = (uint8_t)(1 + ((int32_t)p.layers * in->w) / 900);
            break;
        }
    }
    if (!in->paused) {
        const int32_t cy = (int32_t)in->y + (in->h >> 1), Hh = (in->h >> 1) - 1;
        int32_t bud = LW_BUDGET;
#if TAU_DIAGNOSTIC
        bud = lw_budgets[p.guard];
        if (bud >= 1000000000) lw_stride = 1u;
#endif
        lw_cnt = 0;
        lw_lay_t lay;
#if TAU_DIAGNOSTIC
        uint8_t sc_ph[400], sc_nh[400]; uint16_t sc_pc[400], sc_nc[400];
        lay.ph = sc_ph; lay.nh = sc_nh; lay.pc = sc_pc; lay.nc = sc_nc;
#endif
        lay.L = 0; lay.bm = 0; lay.ba = 0; lay.arr = 0; lay.X = in->x; lay.Y = in->y; lay.H = in->h; lay.W = in->w; lay.cy = cy; lay.bgc = cl.bg;
#if TAU_DIAGNOSTIC
        lay.L = lw_aa_levels[p.aa]; lay.bm = p.bmode; lay.ba = ((int32_t)p.balpha * 255 + 50) / 100; lay.arr = (lay.L || lay.bm) ? 1 : 0;
#endif
#ifdef LW_STATS
        const uint32_t lw_t0 = cycles();
        lw_t_unw = 0;
#endif
        if (p.view == 1u) lw_spectrum(&p, in, &cl, cy, Hh, &lay); else lw_history(&p, in, &cl, cy, Hh, &lay);
#ifdef LW_STATS
        if (lw_cnt) { lw_t_cpu = (uint32_t)(cycles() - lw_t0); lw_cmd_last = (uint32_t)lw_cnt; }   /* what the CPU itself spent issuing */
#endif
#ifdef LW_STATS
        /* On the firmware the cost guard is TIME, not commands (B-524): the redraw is CPU-bound (~60-90 us a command, more in the column maths), so a command
         * budget held the stride high without actually bounding the time. 9 ms of CPU for a redraw on the default guard, scaled by the guard setting. The host
         * build has no clock and keeps the command-count rule below, which is what the golden test compares. */
        if (bud < 1000000000 && lw_cnt) {
            const uint32_t hi = (CLK_HZ / 1000u) * 9u * (uint32_t)bud / 300u;
            lw_stride = (uint8_t)(lw_t_cpu > hi ? lw_min(16, lw_stride + 1) : (lw_t_cpu < (hi >> 1) && lw_stride > 1u ? lw_stride - 1 : lw_stride));
        }
#else
        if (bud < 1000000000 && lw_cnt) lw_stride = (uint8_t)(lw_cnt > bud ? lw_min(16, lw_stride + 1) : (lw_cnt < (bud >> 1) && lw_stride > 1u ? lw_stride - 1 : lw_stride));
#endif
    }
    wviz_force = 0u;
    return !in->paused && lw_cnt > 0;                                 /* commands were issued: helios_meter() presents the box (if it composed it off-screen) */
}

/* helios_meter(): the composed frame could not be shown (the draw engine never drained). Repaint on the next call instead of showing a half-built box. */
COLD_FN3 static void lw_retry(void) { lw_dirty = 1u; }
