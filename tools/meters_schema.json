     "group": "display"
    },
    {
     "key": "hstyle",
     "label": "Spectrum style",
     "type": "enum",
     "values": [
      "BLOCKS",
      "EQ BELLS",
      "CURVE"
     ],
     "default": 0,
     "when": {
      "view": 1
     },
     "help": "How the layers share the frequency axis in SPECTRUM view (experimental).",
     "value_help": [
      "BLOCKS: hard blocks, each layer draws only its own frequency range.",
      "EQ BELLS: the same ranges with soft shoulders that taper into the neighbours, like the bell curves of a parametric EQ.",
      "CURVE: one continuous gradient-coloured outline across the whole axis; the layer colours become colour stops and the layer gains a smooth gain curve."
     ],
     "group": "experimental",
     "experimental": true
    },
    {
     "key": "aa",
     "label": "Antialiasing",
     "type": "enum",
     "values": [
      "OFF",
      "EDGE 2",
      "EDGE 4",
      "EDGE 8"
     ],
     "default": 0,
     "help": "Soften the stair-steps along each layer edge with partly covered pixels (experimental, software). The number is how many coverage levels are used: more levels look smoother but merge less, so they need more drawing commands (see the Info cost table in the lab).",
     "value_help": [
      "OFF: whole pixels only.",
      "EDGE 2: one extra pixel row per edge, half or no coverage.",
      "EDGE 4: four coverage levels.",
      "EDGE 8: eight levels, the smoothest and the most commands."
     ],
     "group": "experimental",
     "experimental": true
    },
    {
     "key": "bmode",
     "label": "Layer blending",
     "type": "enum",
     "values": [
      "OFF",
      "ALPHA",
      "AVERAGE",
      "ADD",
      "SUBTRACT",
      "ADD QUARTER"
     ],
     "default": 0,
     "help": "Composite the layers with the blend modes of the drawing engine's blend unit, computed in software on the colours the CPU already knows (experimental). Each layer is blended over the one outside it, so layers are clamped to nest. Costs no extra drawing commands.",
     "value_help": [
      "OFF: opaque layers.",
      "ALPHA: ordinary translucency, 0-255 alpha.",
      "AVERAGE: half of each, B/2 + F/2.",
      "ADD: layer added to what is underneath, clamped (glow, light on dark).",
      "SUBTRACT: layer subtracted from what is underneath, clamped to black.",
      "ADD QUARTER: a quarter of the layer added, clamped (a faint glow)."
     ],
     "group": "experimental",
     "experimental": true
    },
    {
     "key": "balpha",
     "label": "Blend alpha",
     "type": "u8",
     "min": 5,
     "max": 100,
     "step": 5,
     "default": 60,
     "unit": "%",
     "when": {
      "bmode": 1
     },
     "help": "Opacity of each layer in ALPHA blending.",
     "group": "experimental",
     "experimental": true
    },
    {
     "key": "guard",
     "label": "Cost guard",
     "type": "enum",
     "values": [
      "ON",
      "RELAXED",
      "OFF"
     ],
     "default": 0,
     "help": "The self-scaling guard keeps a frame near 300 drawing commands by widening the drawing cells.",
     "value_help": [
      "ON: budget 300 commands per frame. With several layers at high Resolution the cells are widened, so edges and the taper step at that width.",
      "RELAXED: budget 600 commands; finer cells, about twice the drawing work.",
      "OFF: never widen; the full Resolution you asked for, at whatever it costs (can be well over the budget and starve the audio loop)."
     ],
     "group": "experimental",
     "experimental": true
    },
