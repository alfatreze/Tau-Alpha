{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/alfatreze/Tau-Alpha/docs/schemas/tau-compat.schema.json",
  "title": "tau-compat.json (schema 2)",
  "description": "Compatibility manifest attached to every Tau release for Tau Omega. Generated by tools/tau_compat.py; spec docs/features/RELEASE_SYSTEM_SPEC.md sections 10-11. Readers: refuse a schema number you do not know; ignore object keys you do not know (new keys are additive within a schema number).",
  "type": "object",
  "required": [
    "schema",
    "release",
    "date_release",
    "prerelease",
    "packages",
    "requires_omega",
    "notes"
  ],
  "properties": {
    "schema": {
      "const": 2
    },
    "release": {
      "type": "string",
      "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.]+)?$"
    },
    "date_release": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "prerelease": {
      "type": "boolean"
    },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "zip",
          "zip_sha256",
          "core_id",
          "bitstream_sha256",
          "bitstream_core_version",
          "rom_sha256",
          "cold_sha256",
          "rom_accepts",
          "rom_needs",
          "layout"
        ],
        "properties": {
          "zip": {
            "type": "string",
            "pattern": "\\.zip$"
          },
          "zip_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "core_id": {
            "type": "string",
            "pattern": "^[^./]+\\.[^./]+$"
          },
          "bitstream_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bitstream_core_version": {
            "type": "string",
            "pattern": "^[0-9A-F]{8}$"
          },
          "rom_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "cold_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rom_accepts": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9A-F]{8}$"
            }
          },
          "rom_needs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9_]+$"
            }
          },
          "layout": {
            "description": "Every file this package expects on a card. owned: install/replace exactly, hash must match. shared: install if missing, other cores use it. generated: never in the zip, the companion builds it in `format`. user: never overwrite, check `format`. obsolete: remove on update. `pattern` paths use ** (any folders) and *.{a,b}.",
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "role",
                "slot",
                "required"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(Cores|Assets|Platforms|Settings|Saves|Presets)/"
                },
                "role": {
                  "enum": [
                    "owned",
                    "shared",
                    "generated",
                    "user",
                    "obsolete"
                  ]
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "slot": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "required": {
                  "type": "boolean"
                },
                "pattern": {
                  "type": "boolean"
                },
                "format": {
                  "type": "object",
                  "required": [
                    "name",
                    "version"
                  ],
                  "properties": {
                    "name": {
                      "enum": [
                        "tau-library",
                        "TAUA",
                        "TIM1",
                        "interact_persist"
                      ]
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "sections": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[A-Z0-9]{4}$"
                      }
                    },
                    "max_bytes": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "root": {
                      "description": "tau-library only: the absolute card path the index must embed as its root",
                      "type": "string",
                      "pattern": "^/Assets/[a-z0-9_]+/common/$"
                    },
                    "preserve_unknown_sections": {
                      "description": "TAUA only: a writer must carry every section it does not write byte for byte (user presets live there)",
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "bitstream_features": {
            "description": "Firmware-visible features the bitstream was built with (fit manifest macros through tools/fit_manifest.py FEATURES); null when the release gave the CORE_VERSION by hand. Every rom_needs entry must be in it.",
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9_]+$"
            }
          }
        }
      }
    },
    "requires_omega": {
      "type": "object",
      "required": [
        "library_index_version",
        "assets_sections",
        "assets_read_limit_bytes",
        "report_tags_max",
        "persist_ids_changed",
        "min_omega"
      ],
      "properties": {
        "library_index_version": {
          "type": "integer",
          "minimum": 1
        },
        "assets_sections": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9]{4}$"
          }
        },
        "assets_read_limit_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "report_tags_max": {
          "type": "integer",
          "minimum": 1
        },
        "persist_ids_changed": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "min_omega": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "notes": {
      "type": "string"
    },
    "source": {
      "description": "The commit the tree-derived fields come from; dirty = the tree (outside dist/ and release/) differed from it.",
      "type": "object",
      "required": [
        "commit",
        "dirty"
      ],
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "dirty": {
          "type": "boolean"
        }
      }
    }
  }
}
