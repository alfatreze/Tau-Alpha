-        try:
-            capture_subframe(b, n, ch0, bps + (1 if m == 9 else 0), tuples)
-            if nch != 1:
-                capture_subframe(b, n, ch1, bps + (1 if m in (8, 10) else 0), tuples)
-            b.align(); b.bits(16)
-        except (EOFError, ValueError):
-            break
-        frames += 1
-    return si, frames
-
-
-def main():
