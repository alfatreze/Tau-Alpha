/* ==================================================================== LAYERED WAVE meter (VIZ_LAYERED_WAVE)
 * Nested, mirrored envelope layers on a solid background (docs/features/meters/LAYERED_WAVE_METER_SPEC.md). Inputs are hardware only: the 16 band
 * levels from the spectrum bank (in->spec) and, for the DYNAMICS split, the capture's waveform peak (in->wave). Draws with plain fb_rect().
 *
 * This is the C twin of tools/meters/preview/meters/layered_wave.js: the same integer operations in the same order, so both issue the same engine
 * commands for the same input (sim/test_layered_wave_golden.py compares them command for command; the JS module's header lists the rules that keep
 * them equal). Change one, change the other, run `make test-host`. No floating point anywhere (rv32im has no FPU); the only tables are generated by
 * tools/gen_layered_wave_tables.py into fw/layered_wave_tables.h (cold data).
 *
 * Cost: one command per run of equal-height cells per layer plus the background. A self-scaling `stride` (the width of one evaluation cell) widens
 * when the previous frame needed more than LW_BUDGET commands and narrows when it needed less than half, so a 6-layer 400-column setting degrades
 * to coarser steps instead of starving the audio loop (the B-299 lesson). The meter is COLD code and its state is plain RAM:
 * 6 x 404 history bytes, 6 x 16 band words and a few dozen scalars. */
#include "layered_wave_tables.h"

#define LW_MAXL   6u
#define LW_NB     16u
#define LW_AGE    8u
#define LW_BUDGET 300u
#define LW_HMAX   404u                 /* res (<= 400) + 4 */

typedef struct { uint8_t view, layers, split, outer, nest, draw, speed, response, taper, color_mode, grad, color_outer, color_inner, color_bg, xo[5]; uint16_t res, custom_outer, custom_inner, custom_bg; } lw_p_t;

static uint8_t  lw_hist[LW_MAXL][LW_HMAX];
static int16_t  lw_band[LW_MAXL][LW_NB];
static int32_t  lw_s[LW_MAXL], lw_e[LW_NB], lw_key[6], lw_soft[9], lw_acc, lw_cnt;   /* lw_key: sizes and geometry (a change resets), lw_soft: everything else (a change only repaints) */
static uint8_t  lw_ebounds[LW_MAXL + 1u], lw_ebounds_ok, lw_etick, lw_stride, lw_init, lw_dirty;

static const uint16_t lw_fw[6] = { 1000, 1600, 2560, 4096, 6554, 10486 };   /* BASS_FINE group weights, 1.6^i x 1000 */

static inline int32_t lw_clamp(int32_t v, int32_t a, int32_t b) { return v < a ? a : v > b ? b : v; }
static inline int32_t lw_min(int32_t a, int32_t b) { return a < b ? a : b; }
static inline int32_t lw_max(int32_t a, int32_t b) { return a > b ? a : b; }

COLD_FN3 static uint32_t lw_isqrt(uint64_t n)
{
    uint64_t r = 0, bit = 1ull << 62;
    while (bit > n) bit >>= 2;
    while (bit) { if (n >= r + bit) { n -= r + bit; r = (r >> 1) + bit; } else r >>= 1; bit >>= 2; }
    return (uint32_t)r;
}

COLD_FN3 static void lw_rect(uint32_t x, uint32_t y, uint32_t w, uint32_t h, uint16_t c) { fb_rect(x, y, w, h, c); lw_cnt++; }

/* ---- colours ------------------------------------------------------------------------------------------------------------------- */
COLD_FN3 static uint16_t lw_mix(uint16_t a, uint16_t b, int32_t t256)
{
    const int32_t ar = (a >> 11) & 31, ag = (a >> 5) & 63, ab = a & 31, br = (b >> 11) & 31, bg = (b >> 5) & 63, bb = b & 31;
    return (uint16_t)(((ar + (((br - ar) * t256) >> 8)) << 11) | ((ag + (((bg - ag) * t256) >> 8)) << 5) | (ab + (((bb - ab) * t256) >> 8)));
}
COLD_FN3 static uint16_t lw_pack(int32_t r, int32_t g, int32_t b) { return (uint16_t)((((r * 31 + 127) / 255) << 11) | (((g * 63 + 127) / 255) << 5) | ((b * 31 + 127) / 255)); }
COLD_FN3 static uint16_t lw_hue_rot(uint16_t c, uint32_t which)               /* 0 = -30, 1 = +30, 2 = 180 degrees; grey stays grey */
{
    const int32_t r = (((c >> 11) & 31) * 255 + 15) / 31, g = (((c >> 5) & 63) * 255 + 31) / 63, b = ((c & 31) * 255 + 15) / 31;
    int32_t o[3];
    for (uint32_t i = 0; i < 3u; i++) o[i] = lw_clamp((lw_hue[which][i * 3] * r + lw_hue[which][i * 3 + 1] * g + lw_hue[which][i * 3 + 2] * b + 512) >> 10, 0, 255);
    return lw_pack(o[0], o[1], o[2]);
}
COLD_FN3 static uint16_t lw_role(uint32_t i)                              /* order = the manifest's colour-role enum */
{
    switch (i) {
    case 0:  return ui_accent;
    case 1:  return th_role[TR_TEXT_PRIMARY];
    case 2:  return th_role[TR_TEXT_SECONDARY];
    case 3:  return th_role[TR_OK];
    case 4:  return th_role[TR_WARN];
    case 5:  return th_role[TR_DANGER];
    case 6:  return th_role[TR_PILL];
    case 7:  return th_role[TR_ERROR];
    case 8:  return th_role[TR_SURFACE];
    case 9:  return th_role[TR_SURFACE_TRACK];
    case 10: return th_role[TR_BASE];
    default: return th_role[TR_BG_BOTTOM];
    }
}
COLD_FN3 static void lw_ends(const lw_p_t *p, uint16_t *e)                /* outer, inner, background */
{
    if (p->color_mode == 2u) { e[0] = p->custom_outer; e[1] = p->custom_inner; e[2] = p->custom_bg; return; }
    if (p->color_mode == 1u) { e[0] = lw_role(p->color_outer); e[1] = lw_role(p->color_inner); e[2] = lw_role(p->color_bg); return; }
    const uint16_t a = ui_accent, bg = lw_mix(th_role[TR_BASE], a, 36);
    switch (p->grad) {
    case 1:  e[0] = lw_mix(a, 0, 150); e[1] = a; break;                       /* SHADES */
    case 2:  e[0] = lw_hue_rot(a, 0); e[1] = lw_hue_rot(a, 1); break;                 /* ANALOGOUS */
    case 3:  e[0] = a; e[1] = lw_hue_rot(a, 2); break;                            /* COMPLEMENT */
    default: e[0] = a; e[1] = lw_mix(a, 0xFFFFu, 180); break;                 /* TINTS */
    }
    e[2] = bg;
}
typedef struct { uint16_t base[LW_MAXL], tbl[LW_MAXL][LW_AGE], bg, co, ci; } lw_col_t;
COLD_FN3 static void lw_colours(const lw_p_t *p, lw_col_t *c)
{
    uint16_t e[3];
    lw_ends(p, e);
    c->co = e[0]; c->ci = e[1]; c->bg = e[2];
    const int32_t n = p->layers;
    for (int32_t k = 0; k < n; k++) {
        c->base[k] = n == 1 ? e[0] : lw_mix(e[0], e[1], (k * 512 + (n - 1)) / (2 * (n - 1)));
        for (int32_t q = 0; q < (int32_t)LW_AGE; q++) c->tbl[k][q] = lw_mix(c->base[k], e[2], ((int32_t)p->taper * (2 * q + 1) * 128 + 500) / 1000);
    }
}

/* ---- band split ---------------------------------------------------------------------------------------------------------------- */
COLD_FN3 static void lw_fix(uint8_t *b, int32_t n)
{
    b[0] = 0; b[n] = (uint8_t)LW_NB;
    for (int32_t i = n - 1; i >= 1; i--) b[i] = (uint8_t)lw_min(b[i], (int32_t)LW_NB - (n - i));
    for (int32_t i = 1; i < n; i++) b[i] = (uint8_t)lw_max(b[i], b[i - 1] + 1);
}
COLD_FN3 static void lw_bounds(uint32_t split, int32_t n, uint8_t *b, const uint8_t *xo)
{
    if (split == 4u) {                       /* CUSTOM: the boundaries are parameters (band index between layer i and i+1) */
        b[0] = 0;
        for (int32_t i = 1; i < n; i++) b[i] = xo[i - 1];
    } else if (split == 1u) {
        int32_t s = 0, acc = 0;
        for (int32_t i = 0; i < n; i++) s += lw_fw[i];
        b[0] = 0;
        for (int32_t i = 1; i <= n; i++) { acc += lw_fw[i - 1]; b[i] = (uint8_t)((acc * 32 + s) / (2 * s)); }
    } else if (split == 2u && lw_ebounds_ok) {
        for (int32_t i = 0; i <= n; i++) b[i] = lw_ebounds[i];
        return;
    } else {
        b[0] = 0;
        for (int32_t i = 1; i <= n; i++) b[i] = (uint8_t)((i * 32 + n) / (2 * n));
    }
    lw_fix(b, n);
}
COLD_FN3 static void lw_learn(const uint8_t *spec, int32_t n)             /* ENERGY: boundaries at equal cumulative slow-averaged energy, ~4 times a second */
{
    for (uint32_t k = 0; k < LW_NB; k++) { const int32_t sq = (int32_t)spec[k] * spec[k]; lw_e[k] += (sq - lw_e[k]) / 48; }
    if (++lw_etick < 12u) return;
    lw_etick = 0;
    int32_t tot = 0, acc = 0, g = 1, cnt = 1;
    uint8_t b[LW_MAXL + 1u];
    for (uint32_t k = 0; k < LW_NB; k++) tot += lw_e[k] + 130;
    b[0] = 0;
    for (uint32_t k = 0; k < LW_NB && g < n; k++) { acc += lw_e[k] + 130; while (g < n && acc * n >= tot * g) { b[cnt++] = (uint8_t)(k + 1u); g++; } }
    while (cnt < n) b[cnt++] = (uint8_t)LW_NB;
    b[cnt] = (uint8_t)LW_NB;
    lw_fix(b, n);
    for (int32_t i = 0; i <= n; i++) lw_ebounds[i] = b[i];
    lw_ebounds_ok = 1u;
}
COLD_FN3 static int32_t lw_pnorm(const uint8_t *spec, int32_t lo, int32_t hi, int32_t denom)   /* Q12 power mean of the bands lo..hi-1 */
{
    uint32_t sum = 0;
    for (int32_t k = lo; k < hi; k++) { const uint32_t a = (uint32_t)spec[k] * spec[k]; sum += (a * a) >> 16; }
    const uint32_t M = ((sum * 1040u) >> 10) / (uint32_t)denom, s1 = lw_isqrt((uint64_t)M * 65536u), s2 = lw_isqrt((uint64_t)s1 * 65536u);
    return (int32_t)(lw_min((int32_t)lw_min((int32_t)s2, 65536), 65536) >> 4);
}
COLD_FN3 static void lw_targets(const lw_p_t *p, const uint8_t *spec, const int8_t *wave, int32_t *out)
{
    const int32_t n = p->layers;
    if (p->split == 3u) {
        int32_t pk = 0;
        for (uint32_t i = 0; i < WAVE_COLS; i++) { const int32_t a = wave[i] < 0 ? -wave[i] : wave[i]; if (a > pk) pk = a; }
        const int32_t x = lw_min(4096, pk * 47);
        for (int32_t k = 0; k < n; k++) out[k] = n == 1 ? x : (x * (1024 - (512 * k) / (n - 1))) >> 10;
        return;
    }
    if (p->split == 2u) lw_learn(spec, n);
    uint8_t b[LW_MAXL + 1u];
    lw_bounds(p->split, n, b, p->xo);
    for (int32_t k = 0; k < n; k++) {
        if (p->nest == 0u) {
            const int32_t lo = p->outer == 0u ? b[k] : 0, hi = p->outer == 0u ? (int32_t)LW_NB : b[n - k], v = lw_pnorm(spec, lo, hi, 4);
            out[k] = n == 1 ? v : (v * (1024 - (410 * k) / (n - 1))) >> 10;
        } else {
            const int32_t g = p->outer == 0u ? k : n - 1 - k;
            out[k] = lw_pnorm(spec, b[g], b[g + 1], b[g + 1] - b[g]);
        }
    }
}

/* ---- ballistics ---------------------------------------------------------------------------------------------------------------- */
COLD_FN3 static uint32_t lw_coef(int32_t response, int32_t mul, int32_t dt, int32_t att)   /* Q16 of 1 - exp(-dt/tau) */
{
    uint32_t tau = (4200u * 256u) / (uint32_t)(6 + response);
    if (att) tau >>= 2;
    tau = (tau * (uint32_t)mul) >> 8;
    const uint64_t y = ((uint32_t)dt * 16777216u) / tau >> 3, y2 = (y * y) >> 16, y3 = (y2 * y) >> 16, y4 = (y3 * y) >> 16;
    const uint32_t D = 65536u + (uint32_t)y + (uint32_t)(y2 >> 1) + (uint32_t)(y3 / 6u) + (uint32_t)(y4 / 24u);
    uint32_t E = 2147483648u / (D >> 1);
    if (E > 65535u) E = 65535u;
    for (uint32_t i = 0; i < 3u; i++) E = (E * E) >> 16;
    return 65536u - E;
}
static inline int32_t lw_step(int32_t s, int32_t t, uint32_t ca, uint32_t cr) { return s + (((t - s) * (int32_t)(t > s ? ca : cr)) >> 16); }
static inline uint32_t lw_u8(int32_t v) { return (uint32_t)lw_min(255, (v * 255 + 2048) >> 12); }

/* ---- shape --------------------------------------------------------------------------------------------------------------------- */
COLD_FN3 static int32_t lw_win(const uint8_t (*tab)[65], int32_t q, int32_t pos)
{
    const int32_t i0 = pos >> 8, fr = pos & 255, i1 = lw_min(64, i0 + 1);
    return (int32_t)tab[q - 1][i0] + ((((int32_t)tab[q - 1][i1] - (int32_t)tab[q - 1][i0]) * fr) >> 8);
}
COLD_FN3 static int32_t lw_cr8(const uint8_t *h, int32_t n, int32_t i, int32_t f)       /* Catmull-Rom on 0..255 samples, f in Q8 */
{
    const int32_t p0 = h[lw_max(i - 1, 0)], p1 = h[lw_min(i, n - 1)], p2 = h[lw_min(i + 1, n - 1)], p3 = h[lw_min(i + 2, n - 1)];
    const int32_t a = p2 - p0, b = 2 * p0 - 5 * p1 + 4 * p2 - p3, c = -p0 + 3 * p1 - 3 * p2 + p3;
    const int32_t t2 = b + ((c * f) >> 8), t1 = a + ((t2 * f) >> 8);
    return lw_clamp(p1 + ((t1 * f) >> 9), 0, 255);
}
COLD_FN3 static int32_t lw_half(int32_t a8, int32_t w8, int32_t Hh)                     /* half height in pixels; a thin centre line stays in silence */
{
    int32_t h = (a8 * w8 * Hh + 32512) / 65025;
    if (h < 1 && w8 > 64) h = 1;
    return h;
}

COLD_FN3 static void lw_reinit(const lw_p_t *p, uint32_t W, const int32_t *key, const int32_t *soft)
{
    for (uint32_t i = 0; i < 6u; i++) lw_key[i] = key[i];
    for (uint32_t i = 0; i < 9u; i++) lw_soft[i] = soft[i];
    lw_init = 1u; lw_acc = 0; lw_dirty = 1u; lw_etick = 0; lw_ebounds_ok = 0u; lw_cnt = 0;
    for (uint32_t k = 0; k < LW_MAXL; k++) {
        lw_s[k] = 0;
        for (uint32_t i = 0; i < LW_HMAX; i++) lw_hist[k][i] = 0;
        for (uint32_t i = 0; i < LW_NB; i++) lw_band[k][i] = 0;
    }
    for (uint32_t i = 0; i < LW_NB; i++) lw_e[i] = 0;
    lw_stride = (uint8_t)(1 + ((int32_t)p->layers * (int32_t)W) / 900);
}

COLD_FN3 static void lw_history(const lw_p_t *p, const mtr_in_t *in, const lw_col_t *cl, int32_t cy, int32_t Hh)
{
    const int32_t W = in->w, X = in->x, n = p->layers, res = p->res, smooth = p->draw == 1u, dt = in->dt_ms;
    int32_t tg[LW_MAXL];
    lw_targets(p, in->spec, in->wave, tg);
    for (int32_t k = 0; k < n; k++) {
        const int32_t m = (p->split == 3u && n > 1) ? (int32_t)lw_mul_q8[n - 1 - 2 * k + 5] : 256;
        lw_s[k] = lw_step(lw_s[k], tg[k], lw_coef(p->response, m, dt, 1), lw_coef(p->response, m, dt, 0));
    }
    lw_acc += (dt * p->speed * res * 256) / (1000 * W);
    const int32_t pushes = lw_min(lw_acc >> 8, res);
    lw_acc &= 255;
    for (int32_t i = 0; i < pushes; i++)
        for (int32_t k = 0; k < n; k++) { uint8_t *h = lw_hist[k]; for (int32_t j = res + 3; j > 0; j--) h[j] = h[j - 1]; h[0] = (uint8_t)lw_u8(lw_s[k]); }
    if (!smooth && pushes == 0 && !lw_dirty) return;
    lw_dirty = 0u;
    const int32_t phase = lw_acc, tq = ((int32_t)p->taper + 2) / 5, s = lw_stride;
    lw_rect(X, in->y, W, in->h, cl->bg);
    for (int32_t k = 0; k < n; k++) {
        const uint8_t *h = lw_hist[k];
        int32_t rx0 = 0, rx1 = 0, rh = 0, rq = 0, have = 0;
        for (int32_t xs = 0; xs < W; xs += s) {
            const int32_t wd = lw_min(s, W - xs), xc = lw_min(W - 1, xs + (s >> 1));
            int32_t a8;
            if (smooth) { const int32_t t = ((2 * xc + 1) * res * 128) / W - phase - 128; a8 = t <= 0 ? h[0] : lw_cr8(h, res + 4, t >> 8, t & 255); }
            else a8 = h[lw_min(res - 1, (xc * res) / W)];
            const int32_t w8 = tq == 0 ? 255 : lw_win(lw_win_hist, tq, ((2 * xc + 1) * 8192) / W), hh = lw_half(a8, w8, Hh), q = lw_min((int32_t)LW_AGE - 1, ((2 * xc + 1) * 4) / W);
            if (have && rh == hh && rq == q) { rx1 = xs + wd; continue; }
            if (have) lw_rect(X + rx0, cy - rh, rx1 - rx0, 2 * rh, cl->tbl[k][rq]);
            have = hh > 0; rx0 = xs; rx1 = xs + wd; rh = hh; rq = q;
        }
        if (have) lw_rect(X + rx0, cy - rh, rx1 - rx0, 2 * rh, cl->tbl[k][rq]);
    }
    if (p->taper > 0u) {
        static const uint8_t dots[3] = { 4, 3, 3 };
        for (int32_t j = 0; j < 3; j++) { const int32_t d = dots[j]; lw_rect(X + W - 8 - j * 12 - (d >> 1), cy - (d >> 1), d, d, cl->tbl[n - 1][LW_AGE - 1u]); }
    }
}

COLD_FN3 static void lw_spectrum(const lw_p_t *p, const mtr_in_t *in, const lw_col_t *cl, int32_t cy, int32_t Hh)
{
    const int32_t W = in->w, X = in->x, n = p->layers, smooth = p->draw == 1u, tq = ((int32_t)p->taper + 2) / 5, dt = in->dt_ms;
    const int32_t s = lw_max(lw_stride, (W + (int32_t)p->res - 1) / (int32_t)p->res);   /* Resolution = columns across the width (cell width), never finer than the self-scaling stride allows */
    lw_rect(X, in->y, W, in->h, cl->bg);
    uint8_t bnd[LW_MAXL + 1u];
    if (p->split == 2u) lw_learn(in->spec, n);
    if (p->split != 3u) lw_bounds(p->split, n, bnd, p->xo);   /* frequency splits: each layer draws only the part of the axis it listens to */
    for (int32_t k = 0; k < n; k++) {
        int32_t lo = 0, hi = (int32_t)LW_NB;
        if (p->split != 3u) {
            if (p->nest == 0u) { lo = p->outer == 0u ? bnd[k] : 0; hi = p->outer == 0u ? (int32_t)LW_NB : bnd[n - k]; }
            else { const int32_t g = p->outer == 0u ? k : n - 1 - k; lo = bnd[g]; hi = bnd[g + 1]; }
        }
        const int32_t m = n > 1 ? (int32_t)lw_mul_q8[n - 1 - 2 * k + 5] : 256, sc = n == 1 ? 1024 : 1024 - (512 * k) / (n - 1);
        const uint32_t ca = lw_coef(p->response, m, dt, 1), cr = lw_coef(p->response, m, dt, 0);
        uint8_t bu[LW_NB];
        for (uint32_t i = 0; i < LW_NB; i++) {
            const int32_t v = ((int32_t)in->spec[i] * 4096) / 255;
            lw_band[k][i] = (int16_t)lw_step(lw_band[k][i], v, ca, cr);
            bu[i] = ((int32_t)i >= lo && (int32_t)i < hi) ? (uint8_t)((lw_u8(lw_band[k][i]) * (uint32_t)sc) >> 10) : 0u;
        }
        int32_t rx0 = 0, rx1 = 0, rh = 0, have = 0;
        for (int32_t xs = 0; xs < W; xs += s) {
            const int32_t wd = lw_min(s, W - xs), xc = lw_min(W - 1, xs + (s >> 1));
            int32_t a8;
            if (smooth) { const int32_t t = ((2 * xc + 1) * (int32_t)LW_NB * 128) / W - 128; a8 = t <= 0 ? bu[0] : lw_cr8(bu, (int32_t)LW_NB, t >> 8, t & 255); }
            else a8 = bu[lw_min((int32_t)LW_NB - 1, (xc * (int32_t)LW_NB) / W)];
            const int32_t w8 = tq == 0 ? 255 : lw_win(lw_win_spec, tq, ((2 * xc + 1) * 8192) / W), hh = lw_half(a8, w8, Hh);
            if (have && rh == hh) { rx1 = xs + wd; continue; }
            if (have) lw_rect(X + rx0, cy - rh, rx1 - rx0, 2 * rh, cl->base[k]);
            have = hh > 0; rx0 = xs; rx1 = xs + wd; rh = hh;
        }
        if (have) lw_rect(X + rx0, cy - rh, rx1 - rx0, 2 * rh, cl->base[k]);
    }
}

COLD_FN3 static void lw_tick(const mtr_in_t *in)
{
    lw_p_t p;
    p.view = (uint8_t)MV_LAYERED_WAVE(VIEW);
    p.layers = (uint8_t)lw_clamp((int32_t)MV_LAYERED_WAVE(LAYERS), 1, (int32_t)LW_MAXL);
    p.split = (uint8_t)MV_LAYERED_WAVE(SPLIT); p.outer = (uint8_t)MV_LAYERED_WAVE(OUTER); p.nest = (uint8_t)MV_LAYERED_WAVE(NEST);
    p.draw = (uint8_t)MV_LAYERED_WAVE(DRAW);
    p.res = (uint16_t)lw_clamp((int32_t)MV_LAYERED_WAVE(RES), 16, 400);
    p.speed = (uint8_t)lw_clamp((int32_t)MV_LAYERED_WAVE(SPEED), 20, 240);
    p.response = (uint8_t)lw_clamp((int32_t)MV_LAYERED_WAVE(RESPONSE), 1, 100);
    p.taper = (uint8_t)lw_min(100, (int32_t)MV_LAYERED_WAVE(TAPER));
    p.xo[0] = (uint8_t)lw_clamp((int32_t)MV_LAYERED_WAVE(XO1), 1, 15); p.xo[1] = (uint8_t)lw_clamp((int32_t)MV_LAYERED_WAVE(XO2), 1, 15); p.xo[2] = (uint8_t)lw_clamp((int32_t)MV_LAYERED_WAVE(XO3), 1, 15);
    p.xo[3] = (uint8_t)lw_clamp((int32_t)MV_LAYERED_WAVE(XO4), 1, 15); p.xo[4] = (uint8_t)lw_clamp((int32_t)MV_LAYERED_WAVE(XO5), 1, 15);
    p.color_mode = (uint8_t)MV_LAYERED_WAVE(COLOR_MODE); p.grad = (uint8_t)MV_LAYERED_WAVE(GRAD);
    p.color_outer = (uint8_t)MV_LAYERED_WAVE(COLOR_OUTER); p.color_inner = (uint8_t)MV_LAYERED_WAVE(COLOR_INNER); p.color_bg = (uint8_t)MV_LAYERED_WAVE(COLOR_BG);
    p.custom_outer = (uint16_t)MV_LAYERED_WAVE(CUSTOM_OUTER); p.custom_inner = (uint16_t)MV_LAYERED_WAVE(CUSTOM_INNER); p.custom_bg = (uint16_t)MV_LAYERED_WAVE(CUSTOM_BG);

    lw_col_t cl;
    lw_colours(&p, &cl);
    /* Only the history/band array sizes and the box geometry force a reset; any other change just repaints on the next frame and keeps the history. */
    const int32_t key[6] = { p.layers, p.res, in->w, in->h, in->x, in->y };
    const int32_t soft[9] = { p.view, p.draw, p.split, p.outer, p.nest, p.taper, cl.co, cl.ci, cl.bg };
    int32_t same = lw_init && !in->force;
    for (uint32_t i = 0; i < 6u && same; i++) if (lw_key[i] != key[i]) same = 0;
    if (!same) { lw_reinit(&p, in->w, key, soft); fb_rect(in->x, in->y, in->w, in->h, cl.bg); }
    else for (uint32_t i = 0; i < 9u; i++) if (lw_soft[i] != soft[i]) { lw_soft[i] = soft[i]; lw_dirty = 1u; }
    if (!paused) {
        const int32_t cy = (int32_t)in->y + (in->h >> 1), Hh = (in->h >> 1) - 1;
        lw_cnt = 0;
        if (p.view == 1u) lw_spectrum(&p, in, &cl, cy, Hh); else lw_history(&p, in, &cl, cy, Hh);
        if (lw_cnt) lw_stride = (uint8_t)(lw_cnt > (int32_t)LW_BUDGET ? lw_min(16, lw_stride + 1) : (lw_cnt < (int32_t)(LW_BUDGET >> 1) && lw_stride > 1u ? lw_stride - 1 : lw_stride));
    }
    wviz_force = 0u;
}
