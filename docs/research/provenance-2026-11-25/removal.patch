-	wire        iCYC, iSTB, iWE;
-	wire [29:0] iADR;
-	wire [31:0] iDAT_MOSI;
-	wire [3:0]  iSEL;
-	wire [2:0]  iCTI;
-	wire [1:0]  iBTE;
-
-	wire [31:0] iDAT_MISO = memory[iADR[AW-1:0]];
-	wire        iACK = iCYC & iSTB;   // 0 wait states
-
-	// ---------------- data bus ----------------
-	wire        dCYC, dSTB, dWE;
-	wire [29:0] dADR;
-	wire [31:0] dDAT_MOSI;
-	wire [3:0]  dSEL;
-	wire [2:0]  dCTI;
-	wire [1:0]  dBTE;
-
