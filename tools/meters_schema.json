  {
   "id": 16,
   "schema": 1,
   "key": "layered_wave",
   "name": "LAYERED WAVE",
   "enum": "VIZ_LAYERED_WAVE",
   "selectable": true,
   "retired": false,
   "cost_class": 2,
   "caps": [
    "rect",
    "hw_spectrum",
    "hw_wave"
   ],
   "needs_hw_spec": true,
   "params": [
    {
     "key": "view",
     "label": "View",
     "type": "enum",
     "values": [
      "HISTORY",
      "SPECTRUM"
     ],
     "default": 0,
     "help": "Scrolling or fixed picture.",
     "value_help": [
      "HISTORY: the wave scrolls away from a pointed head; the horizontal axis is time (newest on the left).",
      "SPECTRUM: nothing scrolls; the horizontal axis is frequency, bass on the left, and every layer breathes live. Layers then differ by response time (outer slow, inner fast); Layer split, Outer layer, Layer mode, Scroll speed and Resolution are ignored."
     ],
     "group": "general"
    },
    {
     "key": "layers",
     "label": "Layers",
     "type": "u8",
     "min": 1,
     "max": 6,
     "step": 1,
     "default": 3,
     "help": "How many nested waves are drawn, from 1 to 6. More layers cost one drawing command per layer per column run.",
     "group": "general"
    },
    {
     "key": "split",
     "label": "Layer split",
     "type": "enum",
     "values": [
      "OCTAVES",
      "BASS_FINE",
      "ENERGY",
      "DYNAMICS",
      "CUSTOM"
     ],
     "default": 0,
     "help": "What each layer listens to.",
     "value_help": [
      "OCTAVES: equal groups of the 16 spectrum bands.",
      "BASS_FINE: bass gets the finest layers, treble one wide layer.",
      "ENERGY: boundaries adapt so every layer carries about the same energy, whatever the track.",
      "DYNAMICS: no frequency split; every layer follows the overall peak with its own time constant (the echo look).",
      "CUSTOM: you place the boundaries. In the lab drag the handles under the meter (double-click the strip to add a layer, double-click a handle to remove one); on the Pocket use the Split 1-5 settings."
     ],
     "group": "source"
    },
    {
     "key": "outer",
     "label": "Outer layer",
     "type": "enum",
     "values": [
      "BASS",
      "TREBLE"
     ],
     "default": 0,
     "help": "Which end of the spectrum is the big outer wave: BASS or TREBLE.",
     "group": "source"
    },
    {
     "key": "nest",
     "label": "Layer mode",
     "type": "enum",
     "values": [
      "NESTED",
      "OVERLAP"
     ],
     "default": 0,
     "help": "NESTED: each layer also hears everything inside it, so inner waves can never poke out of outer ones. OVERLAP: each layer hears only its own frequencies and layers may cross.",
     "group": "source"
    },
    {
     "key": "xo1",
     "label": "Split 1",
     "type": "u8",
     "min": 1,
     "max": 15,
     "step": 1,
     "default": 3,
     "when": {
      "split": 4
     },
     "group": "source",
     "help": "Band boundary (1-15) between layer 1 and layer 2, counted in half-octave bands from the bass end (band 1 = about 133 Hz). Only used by the CUSTOM split, and only while Layers is greater than 1. In the lab, drag the handles under the meter instead."
    },
    {
     "key": "xo2",
     "label": "Split 2",
     "type": "u8",
     "min": 1,
     "max": 15,
     "step": 1,
     "default": 5,
     "when": {
      "split": 4
     },
     "group": "source",
     "help": "Band boundary (1-15) between layer 2 and layer 3, counted in half-octave bands from the bass end (band 1 = about 133 Hz). Only used by the CUSTOM split, and only while Layers is greater than 2. In the lab, drag the handles under the meter instead."
    },
    {
     "key": "xo3",
     "label": "Split 3",
     "type": "u8",
     "min": 1,
     "max": 15,
     "step": 1,
     "default": 8,
     "when": {
      "split": 4
     },
     "group": "source",
     "help": "Band boundary (1-15) between layer 3 and layer 4, counted in half-octave bands from the bass end (band 1 = about 133 Hz). Only used by the CUSTOM split, and only while Layers is greater than 3. In the lab, drag the handles under the meter instead."
    },
    {
     "key": "xo4",
     "label": "Split 4",
     "type": "u8",
     "min": 1,
     "max": 15,
     "step": 1,
     "default": 11,
     "when": {
      "split": 4
     },
     "group": "source",
     "help": "Band boundary (1-15) between layer 4 and layer 5, counted in half-octave bands from the bass end (band 1 = about 133 Hz). Only used by the CUSTOM split, and only while Layers is greater than 4. In the lab, drag the handles under the meter instead."
    },
    {
     "key": "xo5",
     "label": "Split 5",
     "type": "u8",
     "min": 1,
     "max": 15,
     "step": 1,
     "default": 13,
     "when": {
      "split": 4
     },
     "group": "source",
     "help": "Band boundary (1-15) between layer 5 and layer 6, counted in half-octave bands from the bass end (band 1 = about 133 Hz). Only used by the CUSTOM split, and only while Layers is greater than 5. In the lab, drag the handles under the meter instead."
    },
    {
     "key": "draw",
     "label": "Draw",
     "type": "enum",
     "values": [
      "BLOCKS",
      "SMOOTH"
     ],
     "default": 1,
     "help": "How the picture is built each frame.",
     "value_help": [
      "BLOCKS: flat chunky columns, redrawn only when a new column arrives.",
      "SMOOTH: a curved outline evaluated across the width with sub-column motion; the best look. Both modes self-scale: if a frame needs more than about 300 drawing commands the meter widens its drawing cells (coarser, never slower)."
     ],
     "group": "display"
    },
    {
     "key": "res",
     "label": "Resolution",
     "type": "u16",
     "min": 16,
     "max": 400,
     "step": 8,
     "default": 200,
     "unit": "cols",
     "help": "Resolution: how many columns span the width, up to 400 (one per pixel). The meter widens its drawing cells automatically if that would need too many commands. HISTORY view only.",
     "when": {
      "view": 0
     },
     "group": "display"
    },
    {
     "key": "speed",
     "label": "Scroll speed",
     "type": "u8",
     "min": 20,
     "max": 240,
     "step": 10,
     "default": 100,
     "unit": "px/s",
     "help": "How fast the wave scrolls, in pixels per second. HISTORY view only.",
     "when": {
      "view": 0
     },
     "group": "dynamics"
    },
    {
     "key": "response",
     "label": "Response",
     "type": "u8",
     "min": 1,
     "max": 100,
     "step": 5,
     "default": 45,
     "help": "How quickly layers follow the music. Low = slow, lingering; high = snappy. Attack is always about 4 times faster than release.",
     "group": "dynamics"
    },
    {
     "key": "taper",
     "label": "Tail taper",
     "type": "u8",
     "min": 0,
     "max": 100,
     "step": 5,
     "default": 70,
     "unit": "%",
     "help": "Roll-off toward the tail: the wave narrows, fades into the background, and ends in three dots. 0 = full height to the edge. In SPECTRUM view both ends are pointed.",
     "group": "display"
    },
    {
     "key": "color_mode",
     "label": "Colour source",
     "type": "enum",
     "values": [
      "ACCENT",
      "THEME",
      "CUSTOM"
     ],
     "default": 1,
     "help": "Where the layer colours come from.",
     "value_help": [
      "ACCENT: derived from your accent colour, with the gradation chosen below. Follows the accent, theme and Dark/Light.",
      "THEME: pick theme colours (roles) for outer layer, inner layer and background. Follows the theme and Dark/Light.",
      "CUSTOM: your own colours, entered as hex in Omega or the lab (colour picker) and stored in the Pocket's 16-bit format."
     ],
     "group": "display"
    },
    {
     "key": "grad",
     "label": "Accent gradation",
     "type": "enum",
     "values": [
      "TINTS",
      "SHADES",
      "ANALOGOUS",
      "COMPLEMENT"
     ],
     "default": 0,
     "when": {
      "color_mode": 0
     },
     "help": "How the layers step away from the accent, outer to inner (ACCENT source only). The background is a dark tint of the accent.",
     "value_help": [
      "TINTS: outer = accent, inner layers lighten toward white.",
      "SHADES: inner = accent, outer layers darken.",
      "ANALOGOUS: neighbouring hues, 30 degrees either side of the accent (pink to violet from a pink accent).",
      "COMPLEMENT: outer = accent, inner = the opposite hue."
     ],
     "group": "display"
    },
